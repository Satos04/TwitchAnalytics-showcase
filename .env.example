APP_NAME=TwitchAnalytics
APP_ENV=local
APP_DEBUG=true
# Used as the "iss" claim of the issued JWTs
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=twitch_analytics
DB_USERNAME=twitch
DB_PASSWORD=change-me

# Path (relative to project root) of the JWT signing key. Generated automatically on first use.
JWT_SECRET=./key.bin

# Twitch application credentials (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_TOKEN=
