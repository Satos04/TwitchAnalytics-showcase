      "name": "Endpoint 4 Games - Happy Path",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Response code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.response.to.be.ok;\r",
              "});\r",
              "\r",
              "pm.test(\"Header application/json\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect( pm.response.headers.get(\"Content-Type\"), \"No hay cabecera application/json\").to.include(\"application/json\");\r",
              "});\r",
              "\r",
              "let limit = pm.request.url.query.get(\"limit\");\r",
              "pm.test(\"Limit Between 1 and 3\", function () {\r",
              "    pm.expect(Number(limit), \"limit must be between 1 and 3\").to.be.within(1, 3);\r",
              "});\r",
              "\r",
              "const schema = {\r",
              "    \"type\": \"array\",\r",
              "    \"minItems\": 1,\r",
              "    \"maxItems\": 3,\r",
              "    \"items\": {\r",
              "        \"type\": \"object\",\r",
              "        \"properties\": {\r",
              "            \"id\": { \"type\": \"string\" },\r",
              "            \"name\": { \"type\": \"string\" },\r",
              "            \"box_art_url\": { \"type\": \"string\" },\r",
              "            \"total_streams\": { \"type\": \"number\" },\r",
              "            \"total_viewers\": { \"type\": \"number\" },\r",
              "            \"average_viewers\": { \"type\": \"number\" },\r",
              "            \"top_streamer\": {\r",
              "                \"type\": \"object\",\r",
              "                \"properties\": {\r",
              "                    \"user_id\": { \"type\": \"string\" },\r",
              "                    \"user_name\": { \"type\": \"string\" },\r",
              "                    \"viewer_count\": { \"type\": \"number\" }\r",
              "                },\r",
              "                \"required\": [\"user_id\", \"user_name\", \"viewer_count\"]\r",
              "            }\r",
              "        },\r",
              "        \"required\": [\r",
              "            \"id\",\r",
              "            \"name\",\r",
              "            \"box_art_url\",\r",
              "            \"total_streams\",\r",
