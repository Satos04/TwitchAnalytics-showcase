      "name": "Endpoint 2 Token - Happy Path",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// use the `pm.*` API to write your test\r",
              "// the `pm.test()` method accepts 2 parameters\r",
              "// the first parameter is the name of your test (be descriptive)\r",
              "// the second parameter is a function whereby if any assertions within your function fail, then the test will fail\r",
              "pm.test(\"Response code is 200\", function () {\r",
              "    // make as many assertions as you'd like as part of this test\r",
              "    // if any assertion throws an error, this test will fail\r",
              "    pm.response.to.have.status(200);\r",
              "    pm.response.to.be.ok;\r",
              "});\r",
              "pm.test(\"Header application/json\", function () {\r",
              "    pm.response.to.have.header(\"Content-Type\");\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\"),\"No hay cabecera de contenido application/json\").to.include(\"application/json\");\r",
              "});\r",
              "const schema = {\r",
              "  \"type\": \"object\",\r",
              "  \"properties\": {\r",
              "    \"token\": {\r",
              "      \"type\": \"string\"\r",
              "    },\r",
              "    \"expires_in\":{\r",
              "        \"type\": \"number\"\r",
              "    }\r",
              "  },\r",
              "  \"required\": [\"token\",\"expires_in\"]\r",
              "};\r",
              "pm.test('Body has token and expiration', function() {\r",
              "  pm.response.to.have.jsonSchema(schema);\r",
              "});\r",
              "let cuerpoJSON = pm.response.json();\r",
              "pm.test(\"Token is available for 3 days\",function(){\r",
              "    pm.expect(cuerpoJSON.expires_in,\"El token no dura 3 dias\").to.equal(259200)\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
