    {
      "name": "Endpoint 1 Register - Happy Path",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Validar que el servidor responde con un 201 Created\r",
              "pm.test(\"Status code is 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "// Validate that the response is valid JSON\r",
              "pm.test(\"Response is JSON\", function () {\r",
              "    pm.response.to.be.withBody;\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "// Validar la estructura y contenido del cuerpo de respuesta\r",
              "pm.test(\"Response body has  data\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    \r",
              "    // Verificar campos obligatorios\r",
              "    pm.expect(jsonData.email).to.be.a('string');\r",
              "    pm.expect(jsonData.api_key).to.be.a('string');\r",
              "    \r",
              "    // Verificar que la API Key tiene una longitud razonable\r",
              "    pm.expect(jsonData.api_key).to.have.lengthOf(32);\r",
              "});\r",
              "\r",
              "// Guardar la API Key en una variable de entorno para el siguiente endpoint\r",
              "if (pm.response.code === 201) {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.environment.set(\"last_api_key\", jsonData.api_key);\r",
              "    pm.environment.set(\"registered_email\", jsonData.email);\r",
              "    console.log(\"Variables de entorno actualizadas: \" + jsonData.email);\r",
              "}\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
